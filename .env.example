# Copy to .env and fill in. Real environment variables take precedence.

# --- LLM backend (any OpenAI-compatible Chat Completions endpoint) ---
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PREMIUM_MODEL=gpt-6-luna      # page synthesis (Step 2), repairs that create pages
LLM_FAST_MODEL=gpt-6-luna         # page selection (Step 1), lint repairs, answers
# Reasoning models (gpt-5*/gpt-6*/o*): effort for text calls (none|low|medium|high).
# Tool calls of the retrieval agent always use "none".
LLM_REASONING_EFFORT=low

# --- Wiki ---
WIKI_LANG=ko                      # ko: Korean content, English section headings
WIKI_CORPUS=assembly_spc          # default --corpus for the llm-wiki CLI
INGEST_STEP_PAUSE=0               # seconds between Step 1 and Step 2 (5 for local servers)
WIKI_DUMP_PROMPTS=0               # 1: save Step 1/2 prompts under wiki_output/<corpus>/logs/prompts/
# ABLATION_ERROR_BOOK=0           # disable the Error Book (paper ablation)
